PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string (replace with your cluster URL)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/heart-disease-detector?retryWrites=true&w=majority

# Long random string – generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Optional path to python binary (defaults to 'python' on Windows, 'python3' on Linux/macOS)
# PYTHON_PATH=python3

# Comma-separated list of allowed frontend origins
FRONTEND_URL=https://your-frontend.vercel.app
